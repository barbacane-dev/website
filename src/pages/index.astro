---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';

const specYaml = `# Applies to every operation
x-barbacane-middlewares:
  - name: oidc-auth
    config:
      issuer_url: https://auth.example.com
      audience: orders-api

paths:
  /orders/{orderId}:
    get:
      operationId: getOrder
      security:
        - bearerAuth: []
      parameters:
        - name: orderId
          in: path
          required: true
          schema: { type: string, format: uuid }
        - name: x-tenant-id
          in: header
          required: true
          schema: { type: string, pattern: "^[a-z0-9-]{3,32}$" }
      x-barbacane-middlewares:
        - name: rate-limit
          config:
            quota: 100
            window: 60
            partition_key: "context:auth.sub"
      x-barbacane-dispatch:
        name: http-upstream
        config:
          url: https://orders.internal.example
`;

const codeThemes = { light: 'github-light', dark: 'github-dark' };

const icons = {
  bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
  badge: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  shield: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  check: 'M5 13l4 4L19 7',
  checkCircle: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  lock: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  key: 'M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z',
  gauge: 'M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z',
  swap: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  terminal: 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  copy: 'M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z',
  document: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  puzzle: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z',
  server: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2',
};

const pillars = [
  {
    name: 'Light',
    color: 'primary',
    icon: icons.bolt,
    intro: 'Nothing on the request path that your API does not need.',
    points: [
      'One static binary of about 30 MB, shipped in a distroless, non-root image',
      'No database, cache or sidecar: a data plane needs only its compiled artifact',
      'Rust, Tokio and Hyper, with no garbage collector to pause your traffic',
      'Route lookup in about 83 ns and full request validation in about 1.2 µs',
    ],
  },
  {
    name: 'Robust',
    color: 'secondary',
    icon: icons.badge,
    intro: 'Mistakes fail the build, and the gateway holds up under pressure.',
    points: [
      'Unknown plugins, invalid configs, route conflicts and broken schemas are compile errors, not runtime surprises',
      'A connection cap with load shedding, plus header-read and TLS handshake timeouts',
      'Plugins run with memory, fuel and wall-clock limits, so a faulty one cannot take the gateway down',
      'Data planes keep serving their last artifact when the control plane is unreachable',
    ],
  },
  {
    name: 'Zero trust',
    color: 'accent',
    icon: icons.shield,
    intro: 'Every request is checked against the contract. Nothing is assumed.',
    points: [
      'Only declared operations route, and every parameter, header and body is validated',
      'Request headers the spec does not declare are dropped before any plugin sees them',
      'Identity headers come only from the auth plugins: a client cannot forge them',
      'Artifacts are signed with Ed25519, and a pinned key makes the gateway refuse anything else',
    ],
  },
];

const enforced = [
  {
    title: 'Only this route exists',
    text: 'Any path or method the spec does not declare gets a 404 or 405. There is no catch-all to forget about.',
  },
  {
    title: 'Inputs match the schema',
    text: 'orderId must be a UUID and x-tenant-id must match its pattern. Anything else is a 400, before the upstream sees it.',
  },
  {
    title: 'The caller is verified',
    text: 'oidc-auth validates the bearer token against the issuer and audience. No valid token, no request.',
  },
  {
    title: 'Undeclared headers never arrive',
    text: 'Headers outside the declared parameters, the security scheme and a fixed baseline are stripped at ingress, including any x-auth-* a client tries to send.',
  },
  {
    title: 'Limits follow the identity',
    text: 'The rate limit partitions on the authenticated subject, which a client cannot spoof.',
  },
];

const features = [
  { title: 'Request validation', icon: icons.checkCircle, color: 'primary', text: 'JSON Schema validation for paths, query strings, headers, cookies and bodies, with $ref resolution and format checks.' },
  { title: 'Authentication', icon: icons.lock, color: 'secondary', text: 'JWT, OIDC, OAuth2 introspection, API keys, Basic and LDAP, wired to the security schemes in your spec.' },
  { title: 'Authorization', icon: icons.key, color: 'accent', text: 'Consumer ACLs, inline CEL expressions and Open Policy Agent, evaluated per operation.' },
  { title: 'Web application firewall', icon: icons.shield, color: 'primary', text: 'OWASP CRS compatible rules compiled into the artifact, inspecting requests and responses.' },
  { title: 'Traffic control', icon: icons.gauge, color: 'secondary', text: 'Sliding-window rate limits, IP restriction, bot detection, request size limits and response caching.' },
  { title: 'Transformation', icon: icons.swap, color: 'accent', text: 'Declarative rewrites of headers, query parameters, paths and JSON bodies, in both directions.' },
  { title: 'Observability', icon: icons.chart, color: 'primary', text: 'Prometheus metrics, OpenTelemetry traces with W3C Trace Context, and structured JSON logs.' },
  { title: 'Events and storage', icon: icons.terminal, color: 'secondary', text: 'AsyncAPI specs bridge HTTP to Kafka, NATS and AWS Lambda. S3 and WebSocket upstreams are first-class.' },
  { title: 'FIPS 140-3 ready', icon: icons.badge, color: 'accent', text: 'TLS through rustls and AWS-LC, a NIST-certified FIPS 140-3 module. No OpenSSL dependency.' },
  { title: 'Provenance', icon: icons.document, color: 'primary', text: 'Every artifact records its content hash and Git commit, and drift detection flags data planes running anything else.' },
  { title: 'WebAssembly plugins', icon: icons.puzzle, color: 'secondary', text: '29 official plugins, and your own in any language that compiles to WebAssembly, each confined to the host functions it declares.' },
  { title: 'Control and data planes', icon: icons.server, color: 'accent', text: 'A control plane compiles and distributes artifacts. Data planes hot-reload them without dropping connections.' },
];

const colorClasses: Record<string, { bg: string; text: string }> = {
  primary: { bg: 'bg-primary-subtle', text: 'text-primary' },
  secondary: { bg: 'bg-secondary-subtle', text: 'text-secondary' },
  accent: { bg: 'bg-accent-subtle', text: 'text-accent' },
};
---

<Layout title="Barbacane - The light, zero-trust API gateway">
  <!-- Hero Section -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 hero-gradient"></div>
    <div class="container-custom relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-background-light border border-themed mb-8">
          <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
          <span class="text-sm text-foreground-muted">Open source &middot; Written in Rust &middot; AGPLv3</span>
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-tight">
          The light, <span class="text-gradient">zero-trust</span> API gateway.
        </h1>

        <p class="text-lg sm:text-xl text-foreground-muted max-w-3xl mx-auto mb-10">
          Barbacane compiles your OpenAPI or AsyncAPI spec into a signed artifact and
          enforces it on every request. Only what the spec declares gets through. One
          static binary, no database, no sidecar.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://docs.barbacane.dev/guide/getting-started.html" class="btn-primary text-lg px-8 py-4">
            Get started
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a href="https://github.com/barbacane-dev/barbacane" target="_blank" rel="noopener" class="btn-secondary text-lg px-8 py-4">
            <svg class="mr-2 w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto mt-14 text-left sm:text-center">
          <div class="card py-4">
            <dt class="text-sm text-foreground-muted">Route lookup, 1,000 routes</dt>
            <dd class="text-2xl font-bold text-primary">~83 ns</dd>
          </div>
          <div class="card py-4">
            <dt class="text-sm text-foreground-muted">Full request validation</dt>
            <dd class="text-2xl font-bold text-secondary">~1.2 µs</dd>
          </div>
          <div class="card py-4">
            <dt class="text-sm text-foreground-muted">Static gateway binary</dt>
            <dd class="text-2xl font-bold text-accent">~30 MB</dd>
          </div>
        </dl>
        <p class="text-xs text-foreground-muted mt-4">
          Criterion micro-benchmarks on an Apple M4.
          <a href="https://github.com/barbacane-dev/barbacane#performance" target="_blank" rel="noopener" class="underline hover:text-primary">Run them yourself</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section id="pillars" class="section bg-background-light">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Light. Robust. <span class="text-gradient">Zero trust.</span>
        </h2>
        <p class="text-xl text-foreground-muted">
          A gateway sits in front of everything you run. It should be the smallest, most
          predictable and most suspicious component in the path.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        {pillars.map((pillar) => (
          <div class="card">
            <div class={`w-12 h-12 rounded-lg ${colorClasses[pillar.color].bg} flex items-center justify-center mb-4`}>
              <svg class={`w-6 h-6 ${colorClasses[pillar.color].text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={pillar.icon}></path>
              </svg>
            </div>
            <h3 class={`text-2xl font-bold mb-2 ${colorClasses[pillar.color].text}`}>{pillar.name}</h3>
            <p class="text-foreground-muted mb-6">{pillar.intro}</p>
            <ul class="space-y-3 text-foreground-muted text-sm">
              {pillar.points.map((point) => (
                <li class="flex items-start gap-2">
                  <svg class={`w-5 h-5 ${colorClasses[pillar.color].text} mt-0.5 shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.check}></path>
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Spec-as-contract Section -->
  <section id="contract" class="section">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Only what the spec declares <span class="text-gradient">gets through</span>
          </h2>
          <p class="text-xl text-foreground-muted max-w-3xl mx-auto">
            There is no separate gateway configuration to drift from your API. The
            operation you document is the operation the gateway enforces, and anything
            you did not document is refused.
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-start">
          <div class="code-block-shiki rounded-lg text-sm overflow-auto">
            <Code code={specYaml} lang="yaml" themes={codeThemes} />
          </div>
          <div class="space-y-6">
            {enforced.map((item) => (
              <div>
                <h3 class="text-xl font-semibold mb-2">{item.title}</h3>
                <p class="text-foreground-muted">{item.text}</p>
              </div>
            ))}
          </div>
        </div>

        <p class="text-center mt-10">
          <a href="/security/" class="text-primary underline">How the trust model works, control by control</a>
        </p>
      </div>
    </div>
  </section>

  <!-- How it works Section -->
  <section class="section bg-background-light">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Spec in, <span class="text-gradient">signed artifact</span> out
        </h2>
        <p class="text-xl text-foreground-muted">
          Checks happen when you build, not when a request fails in production.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="card text-center">
          <div class="w-16 h-16 rounded-2xl bg-primary-subtle flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">1</span>
          </div>
          <h3 class="text-xl font-semibold mb-3">Write the spec</h3>
          <p class="text-foreground-muted">
            Your OpenAPI or AsyncAPI document, with <code class="text-primary">x-barbacane-*</code>
            extensions for middlewares and upstreams. It stays a standard spec that every
            other tool can read.
          </p>
        </div>

        <div class="card text-center">
          <div class="w-16 h-16 rounded-2xl bg-secondary-subtle flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">2</span>
          </div>
          <h3 class="text-xl font-semibold mb-3">Compile and sign</h3>
          <p class="text-foreground-muted">
            <code class="text-secondary">barbacane compile</code> validates every route,
            schema and plugin config, seals the plugins and WAF rules into one
            <code class="text-secondary">.bca</code> artifact, and signs it.
          </p>
        </div>

        <div class="card text-center">
          <div class="w-16 h-16 rounded-2xl bg-accent-subtle flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl">3</span>
          </div>
          <h3 class="text-xl font-semibold mb-3">Verify and serve</h3>
          <p class="text-foreground-muted">
            <code class="text-accent">barbacane serve</code> checks the artifact's integrity
            and signature before it serves a single request, then hot-reloads new versions
            without dropping connections.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WAF Section -->
  <section id="waf" class="section">
    <div class="container-custom">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            A <span class="text-gradient">WAF</span> that compiles with your spec
          </h2>
          <p class="text-xl text-foreground-muted max-w-3xl mx-auto">
            A ModSecurity and OWASP CRS compatible rule set runs as a native stage in the
            pipeline, with no sidecar. Rules are checked at compile time and sealed into
            the artifact, so an unknown directive fails the build instead of silently never
            firing.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">OWASP CRS, native</h3>
            <p class="text-foreground-muted text-sm">
              Stock Core Rule Set v4 compiles in full. SQL injection and XSS detection runs
              on a memory-safe libinjection port that matches the C library on all 163,275
              inputs of its test corpus.
            </p>
          </div>
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">Both directions</h3>
            <p class="text-foreground-muted text-sm">
              Requests and responses are inspected, so a leaked credential or stack trace is
              caught on the way out, not just an attack on the way in.
            </p>
          </div>
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">Bound to the signature</h3>
            <p class="text-foreground-muted text-sm">
              The rule set and its policy are part of the artifact hash, so a signed artifact
              cannot be switched from blocking to detection-only without breaking the
              signature.
            </p>
          </div>
          <div class="card">
            <h3 class="text-lg font-semibold mb-2">Audit log</h3>
            <p class="text-foreground-muted text-sm">
              One structured record per transaction with the matched rules, anomaly scores
              and verdict, ready for your SIEM.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="section bg-background-light">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Everything an <span class="text-gradient">API gateway</span> needs
        </h2>
        <p class="text-xl text-foreground-muted">
          Declared in the spec, checked at compile time, enforced on every request.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map((feature) => (
          <div class="card">
            <div class={`w-12 h-12 rounded-lg ${colorClasses[feature.color].bg} flex items-center justify-center mb-4`}>
              <svg class={`w-6 h-6 ${colorClasses[feature.color].text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon}></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">{feature.title}</h3>
            <p class="text-foreground-muted">{feature.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Architecture Section -->
  <section id="architecture" class="section">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Data planes that stand on their own
        </h2>
        <p class="text-xl text-foreground-muted">
          The control plane builds and distributes artifacts. The data planes serve
          traffic, and nothing on the request path depends on the control plane.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="card">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-primary-subtle flex items-center justify-center">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.server}></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold">Control plane</h3>
          </div>
          <ul class="space-y-2 text-foreground-muted text-sm">
            {[
              'REST API for specs, builds and deployments, behind an admin token',
              'Plugin registry with config schema validation',
              'Spec compilation and artifact builds',
              'Pushes new artifacts to connected data planes',
              'Artifact provenance and drift detection',
            ].map((item) => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.check}></path>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="card">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-secondary-subtle flex items-center justify-center">
              <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.bolt}></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold">Data planes</h3>
          </div>
          <ul class="space-y-2 text-foreground-muted text-sm">
            {[
              'Run from a single artifact file, with or without a control plane',
              'Hot reload without restarts or dropped connections',
              'Keep serving the last artifact if the control plane goes away',
              'TLS termination, mTLS to upstreams and FIPS 140-3 mode',
              'Admin endpoints for health, metrics and provenance',
            ].map((item) => (
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.check}></path>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases Section -->
  <section id="use-cases" class="section bg-background-light">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Built for teams who take APIs seriously
        </h2>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        {[
          {
            title: 'Platform teams',
            color: 'primary',
            text: 'Give every team the same enforced baseline: authentication, validation and limits that come from the spec, not from tickets.',
            points: ['Self-service API publishing', 'Policies enforced, not reviewed', 'One observability story'],
          },
          {
            title: 'API product companies',
            color: 'secondary',
            text: 'The contract you publish is the contract you enforce, so your documentation and your gateway can never disagree.',
            points: ['Contract-first development', 'Documentation that cannot lie', 'Deprecation and sunset headers'],
          },
          {
            title: 'Regulated environments',
            color: 'accent',
            text: 'Signed artifacts, provenance and audit logs give you evidence of what ran, built from components you can inspect.',
            points: ['FIPS 140-3 ready TLS', 'Air-gapped and on-prem deployments', 'Audit-ready WAF logging'],
          },
        ].map((team) => (
          <div class="card">
            <h3 class={`text-2xl font-bold mb-4 ${colorClasses[team.color].text}`}>{team.title}</h3>
            <p class="text-foreground-muted mb-6">{team.text}</p>
            <ul class="space-y-3 text-foreground-muted">
              {team.points.map((point) => (
                <li class="flex items-start gap-2">
                  <svg class={`w-5 h-5 ${colorClasses[team.color].text} mt-0.5 shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons.check}></path>
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

