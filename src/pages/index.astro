  <!-- CTA Section -->
  <section id="get-started" class="section">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="card cta-gradient text-center p-12">
          <h2 class="text-3xl sm:text-4xl font-bold mb-4">
            Put your spec in front of your APIs
          </h2>
          <p class="text-xl text-foreground-muted max-w-2xl mx-auto mb-8">
            Write the spec, compile it, serve it. Minutes, not a migration project.
          </p>

          <div class="code-block rounded-lg p-4 mb-8 max-w-xl mx-auto">
            <code class="text-sm sm:text-base font-mono">
              <span class="text-foreground-muted"># Try the playground with Docker</span><br>
              <span class="text-primary">git</span> clone https://github.com/barbacane-dev/playground<br>
              <span class="text-primary">cd</span> playground && <span class="text-primary">docker-compose</span> up -d<br><br>
              <span class="text-foreground-muted"># Or install from source</span><br>
              <span class="text-primary">cargo</span> install barbacane<br>
              <span class="text-primary">barbacane</span> compile --spec api.yaml --manifest barbacane.yaml --output api.bca<br>
              <span class="text-primary">barbacane</span> serve --artifact api.bca
            </code>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://docs.barbacane.dev/guide/getting-started.html" class="btn-primary text-lg px-8 py-4">
              Read the docs
            </a>
            <a href="/pricing/" class="btn-secondary text-lg px-8 py-4">
              Need help? Talk to us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
